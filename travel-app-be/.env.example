# Backend environment variables for VoxTrail
# Copy to .env and adjust for your Firebase/Google/OpenRouter projects.

APP_PORT=8000
NODE_ENV=development
FIRESTORE_PREFER_REST=true

# Local development: set either base64-encoded credentials or a credential file.
# Managed Firebase Functions/Cloud Run deployments use Application Default
# Credentials and do not need either value.
FB_ADMIN_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase client config for using the Firebase JS SDK on the server (if needed)
FBAPP_API_KEY=your_firebase_web_api_key
FBAPP_AUTH_DOMAIN=your-project.firebaseapp.com
FBAPP_PROJECT_ID=your-project-id
FBAPP_STORAGE_BUCKET=your-project.appspot.com
FBAPP_MESSAGING_SENDER_ID=000000000000
FBAPP_APP_ID=1:000000000000:web:abcdef123456

# External providers
GOOGLE_PLACES_API_KEY=your_google_places_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# AI model chain (ADR-003). Required: there is no built-in default.
# Vendor-prefixed OpenRouter IDs, tried in order; 404/429/5xx fall through.
# Production ignores ":free" models (shared daily cap, can vanish) unless
# OPENROUTER_ALLOW_FREE_MODELS=true. Local development may use them.
OPENROUTER_MODEL_CHAIN=google/gemini-2.5-flash-lite,openai/gpt-4o-mini
# OPENROUTER_MODEL_CHAIN=x-ai/grok-4.1-fast:free   # dev-only free option; check it still has endpoints
OPENROUTER_ALLOW_FREE_MODELS=false
# Default output cap per call; each feature also sets its own
OPENROUTER_MAX_TOKENS=1500
# Translation: google (Cloud Translation, ADC credentials) or openrouter
TRANSLATION_PROVIDER=google
# On Cloud Translation errors, retry with OpenRouter (openrouter | none)
TRANSLATION_FALLBACK=openrouter

# Security
# App Check (ADR-002): monitor mode by default; set true to reject requests
# without a valid X-Firebase-AppCheck token.
APP_CHECK_ENFORCE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com,https://www.yourdomain.com
REQUEST_BODY_LIMIT=256kb

# Rate limits + quotas (ADR-002)
# API-wide flood guard per minute: signed-in (per user) / anonymous (per IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_ANONYMOUS_MAX=30
# Per-user quotas on paid provider calls (durable in production)
TRANSLATION_DAILY_QUOTA=200
LOCATION_RESOLVE_PER_HOUR=60
STAYS_PER_USER_PER_HOUR=60
POI_PER_USER_PER_HOUR=120
PLACE_REVIEWS_PER_HOUR=30

# Google Places cost controls (ADR-004)
# City lookups: geocoding (Geocoding API, cheaper) or places (Text Search)
GEOCODER=geocoding
GEOCODE_CACHE_TTL_DAYS=29
# Signed photo URL lifetime; key is derived from GOOGLE_PLACES_API_KEY
PHOTO_URL_TTL_MS=21600000
PHRASEBOOK_MAX_REQUESTS_PER_HOUR=25
ITINERARY_MAX_REQUESTS_PER_HOUR=20
USAGE_ALERT_FALLBACK=500
