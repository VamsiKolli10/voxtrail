{
  "name": "travel-app-be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_ENV=test jest --runInBand",
    "emulators:start": "firebase emulators:start --only auth,firestore,functions,hosting",
    "emulators:test": "bash ../scripts/prepare-hosting.sh && node ../scripts/run-emulator-tests.js",
    "functions:serve": "firebase emulators:start --only functions",
    "functions:deploy": "firebase deploy --only functions:backend",
    "deploy": "bash ../scripts/firebase-deploy.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "1.20.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-validator": "7.3.2",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0",
    "helmet": "8.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    },
    "@types/request": {
      "form-data": "2.5.6"
    },
    "uuid": "11.1.1"
  }
